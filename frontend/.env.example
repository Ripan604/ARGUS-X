# Optional full URL override (otherwise use the current browser hostname).
# NEXT_PUBLIC_ARGUS_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ARGUS_API_PORT=8000

# Never place ARGUS_API_TOKEN or an access key in a NEXT_PUBLIC variable.
# Shared-engine keys are entered at runtime and scoped to a browser tab.
